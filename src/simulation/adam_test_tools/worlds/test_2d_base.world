<?xml version="1.0"?>
<sdf version="1.6">
  <world name="test_2d_base">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>0 0 -5e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <precon>1</precon>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 0.2 -1</direction>
    </light>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 外围围墙 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.05 0.5 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>12 0.1 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>12 0.1 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.05 0.5 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>12 0.1 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>12 0.1 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6.05 0 0.5 0 0 1.5707963</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>10 0.1 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6.05 0 0.5 0 0 1.5707963</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>10 0.1 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 内侧隔墙（形成多房间格局） -->
    <model name="room_divider_1">
      <static>true</static>
      <pose>-2 0 0.5 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.1 8 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 8 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="room_divider_2">
      <static>true</static>
      <pose>2 0 0.5 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.1 8 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 8 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 可通行门廊 -->
    <model name="doorway_1_left">
      <static>true</static>
      <pose>-2 2.5 0.5 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.1 1.5 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 1.5 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="doorway_1_right">
      <static>true</static>
      <pose>-2 -2.5 0.5 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.1 1.5 1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 1.5 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 室内家具模型（特征丰富） -->
    <include>
      <uri>model://construction_cone</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://construction_cone</uri>
      <pose>3 -2 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://brick_box_3x1x3</uri>
      <pose>-3 -2 0.5 0 0 0</pose>
    </include>
  </world>
</sdf>
