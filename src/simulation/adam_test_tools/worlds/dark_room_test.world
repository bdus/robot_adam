<?xml version="1.0"?>
<sdf version="1.6">
  <world name="dark_room">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>0 0 -5e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver><type>quick</type><iters>50</iters><precon>1</precon></solver>
        <constraints><cfm>0.00001</cfm><erp>0.2</erp><contact_max_correcting_vel>100</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 唯一的光源（通过 SetLightProperties 服务控制开关） -->
    <!-- 命名约定："main_light" 供 /test_tools/toggle_light 及后续 control_light.py 使用 -->
    <light name="main_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.1 0.1 -1</direction>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 封闭暗室（无窗，墙壁不透光） -->
    <model name="room_wall_north">
      <static>true</static>
      <pose>0 8 2 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>16 0.5 4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>16 0.5 4</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="room_wall_south">
      <static>true</static>
      <pose>0 -8 2 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>16 0.5 4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>16 0.5 4</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="room_wall_east">
      <static>true</static>
      <pose>8 0 2 0 0 1.5707963</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>16 0.5 4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>16 0.5 4</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="room_wall_west">
      <static>true</static>
      <pose>-8 0 2 0 0 1.5707963</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>16 0.5 4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>16 0.5 4</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient></material></visual>
      </link>
    </model>

    <!-- 室内柱子（提供一些几何特征，避免完全空旷） -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-3 -3 1 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>0.3 0.3 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 2</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>3 -3 1 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>0.3 0.3 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 2</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static>
      <pose>0 3 1 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>0.3 0.3 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 2</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
