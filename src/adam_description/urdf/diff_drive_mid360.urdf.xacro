<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diff_drive_mid360">

    <!-- =============== 包含公共组件 =============== -->
    <xacro:include filename="$(find adam_description)/urdf/common/common_macros.xacro"/>
    <xacro:include filename="$(find adam_description)/urdf/common/common_inertia.xacro"/>

    <!-- =============== 包含传感器 =============== -->
    <xacro:include filename="$(find adam_description)/urdf/sensors/mid360.xacro"/>
    <xacro:include filename="$(find adam_description)/urdf/sensors/imu.xacro"/>
    <xacro:include filename="$(find adam_description)/urdf/sensors/mono_camera.xacro"/>

    <!-- =============== 包含插件 =============== -->
    <!-- diff_drive 四轮差速控制 -->
    <xacro:include filename="$(find adam_description)/urdf/plugins/gazebo_control_diff.xacro"/>
    <xacro:include filename="$(find adam_description)/urdf/plugins/gazebo_sensors.xacro"/>

    <!-- =============== 创建机器人 =============== -->

    <!-- base_footprint 虚 link -->
    <link name="base_footprint"/>

    <!-- base_link 主底盘 (长 240mm, 宽 180mm, 高 80mm) -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <!-- COM 高度: 轮子半径(0.04) + 底盘半高(0.04) + 间隙 → 0.09 -->
        <origin xyz="0 0 0.09" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.24 0.18 0.08"/>
            </geometry>
            <material name="base_material">
                <color rgba="0.2 0.4 0.8 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.24 0.18 0.08"/>
            </geometry>
            <material name="base_material"/>
        </collision>

        <xacro:box_inertia m="1.5" w="0.24" h="0.08" d="0.18"/>
    </link>

    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
    </gazebo>

    <!-- =============== 四轮差速轮子 (continuous joints) =============== -->
    <!-- 前左轮 -->
    <link name="front_left_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.57079 0 0"/>
            <geometry>
                <cylinder length="0.032" radius="0.04"/>
            </geometry>
            <material name="wheel_material">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57079 0 0"/>
            <geometry>
                <cylinder length="0.032" radius="0.04"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="0.04" h="0.032"/>
    </link>

    <joint name="front_left_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_left_wheel_link"/>
        <origin xyz="0.08 0.085 -0.05" rpy="0 0 0"/>
    </joint>

    <gazebo reference="front_left_wheel_link">
        <material>Gazebo/Black</material>
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
    </gazebo>

    <!-- 前右轮 -->
    <link name="front_right_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.57079 0 0"/>
            <geometry>
                <cylinder length="0.032" radius="0.04"/>
            </geometry>
            <material name="wheel_material">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57079 0 0"/>
            <geometry>
                <cylinder length="0.032" radius="0.04"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="0.04" h="0.032"/>
    </link>

    <joint name="front_right_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_right_wheel_link"/>
        <origin xyz="0.08 -0.085 -0.05" rpy="0 0 0"/>
    </joint>

    <gazebo reference="front_right_wheel_link">
        <material>Gazebo/Black</material>
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
    </gazebo>

    <!-- 后左轮 -->
    <link name="rear_left_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.57079 0 0"/>
            <geometry>
                <cylinder length="0.032" radius="0.04"/>
            </geometry>
            <material name="wheel_material">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57079 0 0"/>
            <geometry>
                <cylinder length="0.032" radius="0.04"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="0.04" h="0.032"/>
    </link>

    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel_link"/>
        <origin xyz="-0.08 0.085 -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="rear_left_wheel_link">
        <material>Gazebo/Black</material>
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
    </gazebo>

    <!-- 后右轮 -->
    <link name="rear_right_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.57079 0 0"/>
            <geometry>
                <cylinder length="0.032" radius="0.04"/>
            </geometry>
            <material name="wheel_material">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57079 0 0"/>
            <geometry>
                <cylinder length="0.032" radius="0.04"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="0.04" h="0.032"/>
    </link>

    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel_link"/>
        <origin xyz="-0.08 -0.085 -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="rear_right_wheel_link">
        <material>Gazebo/Black</material>
        <mu1>0.5</mu1>
        <mu2>0.5</mu2>
    </gazebo>

    <!-- =============== 传感器安装 =============== -->

    <!-- 2D 激光雷达 (顶部中央) -->
    <xacro:mid360 name="laser" parent="base_link">
        <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
    </xacro:mid360>

    <!-- IMU (内部中央) -->
    <xacro:imu name="imu" parent="base_link">
        <origin xyz="0.0 0.0 0.02" rpy="0 0 0"/>
    </xacro:imu>

    <!-- 单目相机 (前部) -->
    <xacro:mono_camera name="camera" parent="base_link">
        <origin xyz="0.12 0.0 0.03" rpy="0 0.2 0"/>
    </xacro:mono_camera>

    <!-- 前向箭头（视觉指示） -->
    <link name="forward_arrow">
        <visual>
            <geometry>
                <box size="0.08 0.01 0.01"/>
            </geometry>
            <material name="arrow_material">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
            <origin xyz="0.20 0 0.06" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="forward_arrow_joint" type="fixed">
        <parent link="base_link"/>
        <child link="forward_arrow"/>
    </joint>

    <!-- =============== 应用插件 =============== -->
    <xacro:gazebo_control/>
    <xacro:gazebo_sensors/>

</robot>