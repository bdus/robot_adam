<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find adam_description)/urdf/common/common_inertia.xacro"/>

    <!-- =============== 阿克曼轮子组件 =============== -->
    <!--
        参数说明:
        - wheel_name: 轮子名称前缀 (如 front_left, front_right, rear_left, rear_right)
        - wheel_type: 轮子类型 (steering=转向轮，drive=驱动轮)
        - xyz: 轮子相对于 base_link 的位置
        - wheel_radius: 轮子半径
        - wheel_width: 轮子宽度
    -->
    <xacro:macro name="ackermann_wheel" params="wheel_name wheel_type xyz wheel_radius:=0.04 wheel_width:=0.032">

        <!-- 轮子 link -->
        <link name="${wheel_name}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
                </geometry>
                <material name="wheel_material">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
                </geometry>
                <material name="wheel_material"/>
            </collision>

            <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
        </link>

        <gazebo reference="${wheel_name}_wheel_link">
            <material>Gazebo/Black</material>
            <mu1 value="1.0"/>
            <mu2 value="1.0"/>
            <kp value="1000000.0"/>
            <kd value="1.0"/>
        </gazebo>

        <!-- 根据轮子类型创建关节 -->
        <xacro:if value="${wheel_type == 'front'}">
            <!-- 前轮：需要转向关节 + 驱动关节 -->

            <!-- 转向关节 (steering joint) -->
            <link name="${wheel_name}_steering_link">
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0"/>
                    <geometry>
                        <box size="0.02 0.02 0.05"/>
                    </geometry>
                    <material name="steering_material">
                        <color rgba="0.5 0.5 0.5 1.0"/>
                    </material>
                </visual>
                <xacro:box_inertia m="0.1" w="0.02" h="0.05" d="0.02"/>
            </link>

            <joint name="${wheel_name}_steering_joint" type="revolute">
                <parent link="base_link"/>
                <child link="${wheel_name}_steering_link"/>
                <origin xyz="${xyz}" rpy="0 0 0"/>
                <axis xyz="0 0 1"/>
                <limit lower="-0.7" upper="0.7" effort="10.0" velocity="1.0"/>
            </joint>

            <!-- 驱动关节 (drive joint) -->
            <joint name="${wheel_name}_drive_joint" type="continuous">
                <parent link="${wheel_name}_steering_link"/>
                <child link="${wheel_name}_wheel_link"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <axis xyz="0 1 0"/>
            </joint>

        </xacro:if>

        <xacro:if value="${wheel_type == 'rear'}">
            <!-- 后轮：只需要驱动关节（无转向） -->
            <joint name="${wheel_name}_drive_joint" type="continuous">
                <parent link="base_link"/>
                <child link="${wheel_name}_wheel_link"/>
                <origin xyz="${xyz}" rpy="0 0 0"/>
                <axis xyz="0 1 0"/>
            </joint>
        </xacro:if>

    </xacro:macro>

</robot>
