<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find adam_description)/urdf/common/common_inertia.xacro"/>

    <!-- =============== 单目相机 =============== -->
    <xacro:macro name="mono_camera" params="name:='camera' parent:='base_link' *origin">

        <!-- 相机本体 -->
        <link name="${name}_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.08 0.02"/>
                </geometry>
                <material name="camera_material">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.08 0.02"/>
                </geometry>
                <material name="camera_material"/>
            </collision>
            <xacro:box_inertia m="0.01" w="0.02" h="0.08" d="0.02"/>
        </link>

        <joint name="${name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}_link"/>
            <xacro:insert_block name="origin"/>
        </joint>

        <!-- 相机光学坐标系 -->
        <link name="${name}_optical_link"/>
        <joint name="${name}_optical_joint" type="fixed">
            <parent link="${name}_link"/>
            <child link="${name}_optical_link"/>
            <origin xyz="0 0 0" rpy="-1.57079 0 -1.57079"/>
        </joint>

        <!-- Gazebo 相机插件 -->
        <gazebo reference="${name}_link">
            <sensor type="camera" name="${name}_sensor">
                <plugin name="${name}_plugin" filename="libgazebo_ros_camera.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>image_raw:=/${name}/image_raw</remapping>
                        <remapping>camera_info:=/${name}/camera_info</remapping>
                    </ros>
                    <frame_name>${name}_optical_link</frame_name>
                    <hack_baseline>0.0</hack_baseline>
                </plugin>
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <camera name="${name}">
                    <horizontal_fov>1.08559</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100.0</far>
                    </clip>
                    <distortion>
                        <k1>0.0</k1>
                        <k2>0.0</k2>
                        <k3>0.0</k3>
                        <p1>0.0</p1>
                        <p2>0.0</p2>
                    </distortion>
                </camera>
            </sensor>
        </gazebo>

    </xacro:macro>

</robot>
